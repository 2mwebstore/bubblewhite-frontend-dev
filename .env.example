# Copy to .env and fill in for your environment.

# The Go backend's API base URL (same value the old Vite app used as
# VITE_API_URL, just with Nuxt's required NUXT_PUBLIC_ prefix so it's
# exposed to both the server and the client bundle).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# This app's own public URL — used to build the sitemap's absolute <loc>
# URLs and canonical/og:url tags. Must NOT be localhost in production (the
# sitemap module will warn/skip generation otherwise).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bakong KHQR — QR generation ------------------------------------------
# Your actual merchant credentials, from registering as a Bakong merchant
# through a participating bank. Without real values here, a QR will still
# generate successfully (the KHQR string format is valid either way), but
# scanning it in a real banking app will fail since the account doesn't
# exist. BAKONG_MERCHANT_NAME is also shown directly to the customer in the
# scan-to-pay popup (see BakongPaymentModal.vue) — it's who they're told
# they're paying.
BAKONG_ACCOUNT_ID=bubblewhite@aclb
BAKONG_MERCHANT_NAME=Bubble White
BAKONG_CITY=Phnom Penh
BAKONG_MERCHANT_ID=000000
BAKONG_ACQUIRING_BANK=ACLBKHPPXXX

# --- Bakong Open API — real payment verification --------------------------
# Used by server/api/khqr-status.post.js to poll whether a generated QR was
# actually paid (customer-facing "scan to pay" auto-detection). Separate
# registration from the merchant credentials above — sign up at
# https://api-bakong.nbc.gov.kh. Note: the GO BACKEND has its OWN identical
# set of these same three variables (see the backend's .env.example) — they
# are two separate deployments/processes and each needs them configured
# independently; setting these here does NOT configure the Go backend too.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_EMAIL=
# Optional. If set, used directly as the API token instead of calling
# renew_token with BAKONG_API_EMAIL — useful for testing, or as a stopgap.
# Leave blank for the normal flow (BAKONG_API_EMAIL + automatic renewal).
BAKONG_API_TOKEN=

# --- Internal service-to-service auth --------------------------------------
# Required for this frontend to fetch its Bakong Open API token FROM the Go
# backend (see server/utils/bakongToken.js) instead of independently calling
# Bakong's renew_token itself — both services doing that separately would
# silently double up on Bakong's shared daily request quota for no benefit.
# MUST be the exact same value as INTERNAL_API_SECRET on the Go backend —
# generate any long random string and use it on both.
INTERNAL_API_SECRET=

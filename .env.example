# Copy to .env and fill in for your environment.

# The Go backend's API base URL (same value the old Vite app used as
# VITE_API_URL, just with Nuxt's required NUXT_PUBLIC_ prefix so it's
# exposed to both the server and the client bundle).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# This app's own public URL — used to build the sitemap's absolute <loc>
# URLs and canonical/og:url tags. Must NOT be localhost in production (the
# sitemap module will warn/skip generation otherwise).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google/Facebook sign-in on the login and register pages. Both optional —
# leave either blank to hide that provider's button entirely rather than
# show one that would just fail. These are public client identifiers, safe
# to expose in the browser (unlike Facebook's app SECRET, which stays
# backend-only in the Go server's own .env — see FACEBOOK_APP_SECRET
# there, never here).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_FACEBOOK_APP_ID=

# Telegram Login Widget. Optional — leave blank to hide the button. This is
# just the bot's @username (no @, e.g. "BubbleWhiteBot"), not a secret — the
# actual bot TOKEN that verifies sign-ins lives on the backend only (same
# TELEGRAM_BOT_TOKEN already used there for order notifications, see the
# backend's own .env.example). Before this works, message @BotFather on
# Telegram, run /setdomain, and set it to your exact site domain — the
# widget refuses to load on any domain not registered this way.
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=
